Completion:
  AllScopes: true
  HeaderInsertion: Never
CompileFlags:
  Add: [-I/opt/homebrew/include]

---
# C++
If:
  PathMatch: '.*\.(cpp|cc|cxx|hpp|hxx)$'
CompileFlags:
  Remove: [-std=*]
  Add:
    - -std=c++23

---
# C
If:
  PathMatch: '.*\.c$'
CompileFlags:
  Remove: [-std=*]
  Add:
    - -std=c23
